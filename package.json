{
  "name": "flow-state",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p apps/server --pretty false",
    "dev": "pnpm --filter @flow/web dev",
    "build": "pnpm --filter @flow/web build",
    "sweep": "tsx packages/headless/src/cli.ts",
    "deck": "node docs/deck/build.mjs",
    "notes": "node docs/notes.mjs",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && pnpm --filter @flow/server deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
